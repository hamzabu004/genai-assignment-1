# ==============================================================================
# Environment Configuration & API Keys
# Copy this file to .env and fill in your credentials.
# Note: .env is in .gitignore and will not be tracked by Git.
# ==============================================================================

# Weights & Biases (W&B) API Key
# Get your free key from https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here

# W&B Default Settings
WANDB_PROJECT=genai-assignment
WANDB_ENTITY=

# Checkpoint Cloud Uploading
# Set to 'true' to automatically upload checkpoints (.pt) to W&B Artifacts on each save
WANDB_LOG_MODEL=true
